MYSQL_ROOT_PASSWORD=root@9966
JWT_SECRET=expirymate-demo-secret-key-must-be-at-least-32-bytes

# Local Docker demo: Mailpit
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=reminders@expirymate.local

# To send to real inboxes using Gmail SMTP, replace the mail values above:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-sender@gmail.com
# MAIL_PASSWORD=your-google-app-password
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=your-sender@gmail.com

REMINDER_SCAN_DELAY_MS=60000
